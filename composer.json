{
  "name": "ultimatemember/ultimatemember",
  "description": "The easiest way to create powerful online communities and beautiful user profiles with WordPress.",
  "type": "wordpress-plugin",
  "homepage": "https://wordpress.org/plugins/ultimate-member/",
  "license": "GPL-3.0-or-later",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "oomphinc/composer-installers-extender": true
    },
    "audit": {
      "ignore": [
        "PKSA-w9tt-7782-78jx",
        "PKSA-pwh8-d4fr-nywn"
      ]
    },
    "policy": {
      "advisories": {
        "ignore-id": [
          "PKSA-w9tt-7782-78jx",
          "PKSA-pwh8-d4fr-nywn"
        ]
      }
    }
  },
  "require": {
    "ext-mbstring": "*",
    "ext-json": "*",
    "ext-dom": "*",
    "ext-exif": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-tidy": "*",
    "woocommerce/action-scheduler": "3.9.*",
    "wp-cli/wp-config-transformer": "^1.4"
  },
  "require-dev": {
    "wp-cli/wp-cli": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "*",
    "phpcompatibility/phpcompatibility-wp": "*",
    "wp-coding-standards/wpcs": "*",
    "symplify/phpstan-rules": "*",
    "phpdocumentor/phpdocumentor": "3.8.*",
    "sniccowp/php-scoper-wordpress-excludes": "7.0.*"
  },
  "scripts": {
    "wordpress-excludes": [
      "@php -r \"$dest = 'includes/lib/php-scoper-wordpress-excludes/'; if (!is_dir($dest)) { mkdir($dest, 0755, true); }; copy('vendor/sniccowp/php-scoper-wordpress-excludes/generated/exclude-wordpress-functions.json', $dest . 'exclude-wordpress-functions.json');\""
    ],
    "wp-config-transformer": [
      "@php -r \"@mkdir('includes/lib/wp-config-transformer/src', 0755, true); if (is_file('vendor/wp-cli/wp-config-transformer/src/WPConfigTransformer.php')) { copy('vendor/wp-cli/wp-config-transformer/src/WPConfigTransformer.php', 'includes/lib/wp-config-transformer/src/WPConfigTransformer.php'); }\""
    ],
    "copy-libs": [
      "@php -r \"function rcopy($src, $dst) { if (!is_dir($dst)) @mkdir($dst, 0755, true); $dir = opendir($src); while (false !== ($file = readdir($dir))) { if ($file != '.' && $file != '..') { if (is_dir($src . '/' . $file)) { rcopy($src . '/' . $file, $dst . '/' . $file); } else { copy($src . '/' . $file, $dst . '/' . $file); } } } closedir($dir); } if (is_dir('vendor/woocommerce/action-scheduler')) { rcopy('vendor/woocommerce/action-scheduler', 'includes/lib/action-scheduler'); }\"",
      "@php -r \"@mkdir('includes/lib/wp-config-transformer/src', 0755, true); if (is_file('vendor/wp-cli/wp-config-transformer/src/WPConfigTransformer.php')) { copy('vendor/wp-cli/wp-config-transformer/src/WPConfigTransformer.php', 'includes/lib/wp-config-transformer/src/WPConfigTransformer.php'); }\""
    ],
    "post-install-cmd": [
      "@copy-libs"
    ],
    "post-update-cmd": [
      "@copy-libs"
    ]
  }
}
